def witnessWord (m : BitVec 15) : Nat :=
  (witnessChunk (m.toNat / 128) / 2^(20*(m.toNat % 128))) % 1048576

def witnessShape (w : Nat) : Fin 6 := ⟨(w / 46656) % 6, Nat.mod_lt _ (by decide)⟩
def witnessMap (w : Nat) (i : Fin 6) : Fin 6 :=
  ⟨(w / 6^i.val) % 6, Nat.mod_lt _ (by decide)⟩

def ValidWitness (m : BitVec 15) (w : Nat) : Prop :=
  if 500000 ≤ w then
    let c := w-500000
    0 < c ∧ c < 63 ∧
      ∀ i j : Fin 6, c.testBit i.val = true → c.testBit j.val = false → bitAdj m i j = false
  else
    Function.Injective (witnessMap w) ∧
      ∀ i j : Fin 6,
        bitAdj m (witnessMap w i) (witnessMap w j) = bitAdj (canonicalMask (witnessShape w)) i j

instance (m : BitVec 15) (w : Nat) : Decidable (ValidWitness m w) := by
  unfold ValidWitness
  split <;> infer_instance

def certificateCheck (m : BitVec 15) : Bool :=
  decide (countEdges m ≠ 5 ∨ ValidWitness m (witnessWord m))

